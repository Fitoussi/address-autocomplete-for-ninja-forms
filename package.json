{
	"name": "wpgeo-address-autocomplete-for-ninja-forms",
	"version": "1.0.1",
	"description": "Google Places address autocomplete for Ninja Forms",
	"scripts": {
		"test": "npm run test:php && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/js/*.test.mjs",
		"test:php": "php tests/contracts.php && php tests/activation-notice.php && php tests/overview.php && php tests/bootstrap-conflict.php && php tests/package.php && php tests/dashboard-module.php",
		"package": "npm run build && php tools/package/build.php",
		"build": "npm run css && node build.js",
		"css": "sass assets/scss/admin/nfgeo-admin.scss:build/css/admin/nfgeo-admin.css src/Admin/Dashboard/assets/scss/dashboard.scss:src/Admin/Dashboard/assets/css/dashboard.css --no-source-map && sass assets/scss/admin/nfgeo-admin.scss:build/css/admin/nfgeo-admin.min.css src/Admin/Dashboard/assets/scss/dashboard.scss:src/Admin/Dashboard/assets/css/dashboard.min.css --style=compressed --no-source-map",
		"watch": "chokidar 'assets/js/**/*.js' -c 'node build.js'",
		"css:dashboard": "sass src/Admin/Dashboard/assets/scss/dashboard.scss:src/Admin/Dashboard/assets/css/dashboard.css --style=expanded --no-source-map && sass src/Admin/Dashboard/assets/scss/dashboard.scss:src/Admin/Dashboard/assets/css/dashboard.min.css --style=compressed --no-source-map"
	},
	"devDependencies": {
		"chokidar-cli": "^3.0.0",
		"esbuild": "^0.19.0",
		"jsdom": "20.0.3",
		"npm-run-all": "^4.1.5",
		"sass": "^1.69.5",
		"jquery": "3.7.1"
	}
}
